   "good": {
    "title": "More or less baskets",
    "format": "game",
    "core_lo": "written-K2-LO-01",
    "character_los": [
     "written-K2-CH-01"
    ],
    "minutes": 15,
    "grouping": "small groups",
    "steps": [
     "Sit the group in a circle with two baskets in the middle.",
     "Put a few counters in one basket and more in the other.",
     "Ask one child: which basket has more?",
     "The child points and says the basket.",
     "Pass the counters to the next child to fill two new baskets.",
     "End when every child has had two turns."
    ],
    "watch_for": [
     "Does the child count or match one to one before answering?",
     "Does the child say more or less for the right basket?",
     "Does the child wait while others have their turn?"
    ],
    "materials": [
     "counters",
     "small baskets"
    ]
   },
   "expect": {
    "core_lo": "written-K2-LO-01"
   }
