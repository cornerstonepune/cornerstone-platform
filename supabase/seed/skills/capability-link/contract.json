   "grade",
   "subject",
   "objective",
   "domain_default"
  ],
  "properties": {
   "grade": {
    "type": "string"
   },
   "subject": {
    "type": "string"
   },
   "unit": {
    "type": "string"
   },
   "objective": {
    "type": "string",
    "description": "the learning objective's wording"
   },
   "kind": {
    "enum": [
     "academic",
     "character"
    ]
   },
   "domain_default": {
    "type": "string",
