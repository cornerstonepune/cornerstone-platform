{
 "input": {
  "type": "object",
  "required": [
   "grade",
   "subject",
   "topic",
   "text",
   "rewrite"
  ],
  "properties": {
   "grade": {
    "type": "string"
   },
   "subject": {
    "type": "string"
   },
   "topic": {
    "type": "string"
   },
   "text": {
    "type": "string",
    "description": "the school's wording today: a title, a purpose, a list, or an objective"
   },
   "kind": {
    "enum": [
     "academic",
     "character"
    ]
   },
   "rewrite": {
    "type": "boolean"
   },
   "siblings": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "sibling_codes": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "statements": {
    "type": "array",
    "items": {
     "type": "object",
     "required": [
      "code",
      "framework",
      "text"
     ],
     "properties": {
      "code": {
       "type": "string"
      },
      "framework": {
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     }
    }
   },
   "part": {
    "type": "string",
    "description": "set by code when the school's line is a list: the one part this objective covers"
   },
   "other_parts": {
    "type": "array",
    "items": {
     "type": "string"
    },
    "description": "the parts other objectives cover: not this one's to write"
   },
   "nearest": {
    "type": "array",
    "description": "set by code: the objectives of the same grade closest in wording, which this one must not repeat",
    "items": {
     "type": "object",
     "required": [
      "code",
      "text"
     ],
     "properties": {
      "code": {
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     }
    }
   }
  }
 },
 "output": {
  "type": "object",
  "additionalProperties": false,
  "required": [
   "text",
   "signal",
   "source",
   "source_text",
   "confidence"
  ],
  "properties": {
   "text": {
    "type": "string",
    "minLength": 10
   },
   "signal": {
    "enum": [
     "Foundational",
     "Conceptual",
     "Procedural",
     "Application",
     "Stretch"
    ]
   },
   "source": {
    "type": "string",
    "minLength": 1
   },
   "source_text": {
    "type": "string"
   },
   "confidence": {
    "enum": [
     "high",
     "medium",
     "low"
    ]
   },
   "assumption": {
    "type": "string",
    "description": "the assumption made where the sources were thin; empty when none"
   }
  }
 }
}
