{
 "input": {
  "type": "object",
  "required": [
   "subject",
   "grade",
   "lo_texts",
   "existing_topics"
  ],
  "properties": {
   "subject": {
    "type": "string"
   },
   "grade": {
    "type": "string"
   },
   "lo_texts": {
    "type": "array",
    "minItems": 1,
    "items": {
     "type": "string"
    },
    "description": "the school's wording of each LO or unit title in the group"
   },
   "existing_topics": {
    "type": "array",
    "description": "the topics this subject already has",
    "items": {
     "type": "object",
     "required": [
      "code",
      "name"
     ],
     "properties": {
      "code": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     }
    }
   }
  }
 },
 "output": {
  "type": "object",
  "additionalProperties": false,
  "required": [
   "topic",
   "reuse",
   "source",
   "confidence"
  ],
  "properties": {
   "topic": {
    "type": "string",
    "minLength": 2
   },
   "reuse": {
    "type": [
     "string",
     "null"
    ],
    "description": "the code of the existing topic this is, or null for a new topic"
   },
   "source": {
    "type": "string",
    "minLength": 1
   },
   "confidence": {
    "enum": [
     "high",
     "medium",
     "low"
    ]
   },
   "assumption": {
    "type": "string",
    "description": "the assumption made where the sources were thin; empty when none"
   }
  }
 }
}
