{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/check --claude",
            "timeout": 180
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/athena/bin/athena\" hook stop",
            "timeout": 900
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.athena/bin/canny-hook\" ]; then \"$HOME/.athena/bin/canny-hook\"; elif command -v canny >/dev/null 2>&1; then canny hook --agent claude; fi",
            "timeout": 15,
            "statusMessage": "canny: done-gate"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/athena/bin/athena\" hook session-start",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.athena/bin/canny-hook\" ]; then \"$HOME/.athena/bin/canny-hook\"; elif command -v canny >/dev/null 2>&1; then canny hook --agent claude; fi",
            "timeout": 10,
            "statusMessage": "canny: done-gate"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/athena/bin/athena\" hook prompt",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/athena/bin/athena\" hook guard",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.athena/bin/rtk\" ] || command -v rtk >/dev/null 2>&1 || exit 0; PATH=\"$HOME/.athena/bin:$PATH\" rtk hook claude",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.athena/bin/canny-hook\" ]; then \"$HOME/.athena/bin/canny-hook\"; elif command -v canny >/dev/null 2>&1; then canny hook --agent claude; fi",
            "timeout": 10,
            "statusMessage": "canny: done-gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/athena/bin/athena\" hook ledger",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/athena/bin/athena\" hook ui-slop",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.athena/bin/canny-hook\" ]; then \"$HOME/.athena/bin/canny-hook\"; elif command -v canny >/dev/null 2>&1; then canny hook --agent claude; fi",
            "timeout": 15,
            "statusMessage": "canny: done-gate"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.athena/bin/canny-hook\" ]; then \"$HOME/.athena/bin/canny-hook\"; elif command -v canny >/dev/null 2>&1; then canny hook --agent claude; fi",
            "timeout": 15,
            "statusMessage": "canny: done-gate"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__github__merge_pull_request",
      "mcp__github__update_pull_request"
    ]
  },
  "env": {
    "AUTOHARNESS_DISABLE_GLOBAL": "1",
    "AUTOHARNESS_CAPACITY_PROJECT": "15",
    "PONYTAIL_DEFAULT_MODE": "full",
    "WINNOW_MODE": "active",
    "WINNOW_TOOLS": "Read,Grep",
    "WINNOW_SUMMARY": "0",
    "WINNOW_MODEL": "jev-1.13.0",
    "AUTOHARNESS_REFLECT_EVERY_N": "150",
    "RTK_SUPPRESS_HOOK_WARNING": "1",
    "STRIX_TELEMETRY": "0",
    "ARCHIFY_UPDATE_CHECK_DISABLED": "1",
    "GRAPHIFY_BACKEND": "none",
    "GRAPHIFY_NO_AUTO_REFRESH": "1",
    "GRAPHIFY_NO_TIPS": "1",
    "GRAPHIFY_QUERY_LOG": "~/.athena/graphify-queries.jsonl",
    "DO_NOT_TRACK": "1",
    "DISABLE_TELEMETRY": "1"
  }
}
