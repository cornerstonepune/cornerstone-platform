{
  "test_command": "cd packages/engine && export TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54329/postgres} && uv run pytest -q -p no:cacheprovider -m core tests && if ls tests/holdout/test_*.py >/dev/null 2>&1; then uv run pytest -q -p no:cacheprovider tests/holdout; fi",
  "typecheck_command": "cd packages/engine && uv run pytest -q -p no:cacheprovider tests/test_types.py",
  "lint_command": "cd packages/engine && uv run ruff check engine tests && uv run ruff format --check engine tests",
  "coverage_command": "",
  "setup_command": "cd packages/engine && uv sync --extra dev && uv run playwright install chromium",
  "models": {
    "small": "haiku",
    "standard": "sonnet",
    "plan": "opus",
    "rescue": "fable"
  },
  "main_branches": [
    "main",
    "master"
  ],
  "protected": [
    "PROJECT.md",
    "CLAUDE.md",
    ".loop.json",
    "db/schema.sql",
    "prisma/schema.prisma",
    "**/schema.prisma",
    "docs/adr/**",
    ".github/workflows/**",
    "design/**",
    "docs/frontend/DESIGN.md",
    "docs/frontend/tokens.json",
    "docs/frontend/page-charter.md",
    "docs/ux-rules.md",
    "apps/web/design-system/tokens.css",
    "apps/web/components/educator/school-tokens.css"
  ],
  "tests": [
    "tests/**",
    "test/**",
    "**/__tests__/**",
    "**/test_*.py",
    "**/*_test.py",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*_test.go"
  ],
  "frontend": [
    "app/**/*.tsx",
    "src/app/**",
    "src/components/**",
    "src/pages/**",
    "apps/web/**",
    "components/**",
    "**/*.tsx",
    "**/*.jsx",
    "**/*.vue",
    "**/*.svelte",
    "**/*.css"
  ],
  "token_files": [
    "design/**",
    "**/tokens.css",
    "**/brand.css",
    "docs/frontend/tokens.json",
    "apps/web/components/educator/school-tokens.css"
  ],
  "brand_overridable": [
    "--accent",
    "--accent-2",
    "--accent-soft",
    "--accent-rule",
    "--wash-1",
    "--wash-2",
    "--wash-3",
    "--font-serif",
    "--font-sans"
  ],
  "max_attempts": 3,
  "default_budget": {
    "files": 3,
    "lines": 200
  },
  "holdout": [
    "tests/holdout/**",
    "**/holdout/**"
  ],
  "context_budget": 150000,
  "release": {
    "staging_migrate": "",
    "staging_deploy": "",
    "staging_smoke": "",
    "prod_migrate": "",
    "prod_deploy": "",
    "prod_smoke": "",
    "require_go": true
  }
}
