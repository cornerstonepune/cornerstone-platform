#!/usr/bin/env bash
# The checks that hold the code to its map and every promise to a command (ADR 0033): the engine's layout
# against workflows.json, every goal line a command or one of Nimish's sentences with its test, no baseline loosened
# since the last commit, the type checker's verdict, the website's list of the engine's routes, lint, and the wireframes
# against the list of controls each screen has (docs/frontend/wireframes/check.mjs: a screen's elements changed without
# its drawing redrawn was red on main for days, because nothing ran it).
# Fast and with no database, so it runs every time rather than when someone remembers:
#   before every commit            .githooks/pre-commit
#   before Claude Code ends a turn .claude/settings.json (Stop hook) — `--claude` makes a failure block it
# `bin/check --db` adds the checks that need a database (TEST_DATABASE_URL); the stop gate adds them whenever it is set.
# `bin/check --local-url URL` says whether URL is a database on this machine (exit 0) or not; tests/test_check_db_url.py.
here=$(cd "$(dirname "$0")/.." && pwd)
engine="$here/packages/engine"
if [ ! -x "$engine/.venv/bin/python" ]; then
  echo "engine is not installed yet: cd $engine && uv sync" >&2
  exit 1
fi
# the wireframe check, and its list of data the target tables lack: node alone, no install, no database
wireframes() {
  local out
  out=$(cd "$here" && node docs/frontend/wireframes/check.mjs 2>&1 && node docs/frontend/wireframes/check.mjs --gaps 2>&1) || {
    printf '%s\n' "$out" | grep -E "✗|problem" >&2
    return 1
  }
  # the files made from the inventory and the tokens (the help's words among them): an inventory edit without them was red only in
  # CI's browser shard (u14), after a push; the script prints what is stale and nothing when all is current
  out=$(cd "$here" && node apps/web/scripts/tokens.mjs --check 2>&1)
  [ -z "$out" ] && return 0
  printf '%s\n' "$out" >&2
  return 1
}
run() {
  wireframes &&
  cd "$engine" &&
    DATABASE_URL= TEST_DATABASE_URL= .venv/bin/python -m pytest tests/test_layout.py tests/test_promises.py tests/test_ratchet.py \
      tests/test_types.py tests/test_contract.py tests/test_migration_order.py tests/test_grades.py tests/test_school_words.py \
      tests/test_check_db_url.py \
      -q -p no:cacheprovider -o addopts= &&
    .venv/bin/ruff check engine tests -q &&
    .venv/bin/ruff format --check engine tests -q
}
# --db, and the stop gate whenever TEST_DATABASE_URL is set: what needs a database, on a database of its own beside the
# local one (never the copy itself), built from every migration with the seed and no bank (bin/testdb schema). A table
# with no owner, rules.json behind the migrations, and the grade and rule tests that skip without a database.
# One exact shape, matched whole in bash (not a glob, not line by line: `?host=`, a second @, a comma list, a path trick or a
# line break must not send libpq to another server while the rest looks local; CP-21's lesson, docs/athena/learnings.md).
local_url() {
  local shape='^postgres(ql)?://[A-Za-z0-9_]+(:[A-Za-z0-9_.~-]*)?@(127\.0\.0\.1|localhost)(:[0-9]+)?/[A-Za-z0-9_]+$'
  [[ $1 =~ $shape ]]
}
db() (
  url=${TEST_DATABASE_URL:?"bin/check --db needs TEST_DATABASE_URL, a local Postgres"}
  local_url "$url" || {
    echo "bin/check --db: TEST_DATABASE_URL must look like postgresql://postgres@127.0.0.1:5432/postgres (a user, this machine, a plain database name, no query)" >&2
    exit 1
  }
  name="cs_check_$$"
  scratch=$(python3 -c 'import sys, urllib.parse as u; p = u.urlsplit(sys.argv[1]); print(u.urlunsplit(p._replace(path="/" + sys.argv[2])))' "$url" "$name")
  trap 'psql "$url" -qc "drop database if exists $name with (force)" >/dev/null 2>&1' EXIT
  psql "$url" -q -v ON_ERROR_STOP=1 -c "create database $name" || exit 1
  "$here/bin/testdb" schema "$scratch" >/dev/null || exit 1
  if ! "$here/bin/engine" live rules --url "$scratch"; then
    echo "rules.json is not the rules the migrations make: run \`engine live rules --write\` on a database built from them" >&2
    exit 1
  fi
  cd "$engine" &&
    DATABASE_URL= TEST_DATABASE_URL="$scratch" .venv/bin/python -m pytest tests/test_grades.py tests/test_rules.py \
      -q -p no:cacheprovider -o addopts=
)
if [ "${1:-}" = "--local-url" ]; then
  local_url "${2:-}"
  exit
fi
if [ "${1:-}" = "--db" ]; then
  run && db
  exit
fi
if [ "${1:-}" = "--claude" ]; then
  [ -n "${TEST_DATABASE_URL:-}" ] || echo "bin/check: TEST_DATABASE_URL is not set, so the database checks were skipped (bin/check --db runs them)." >&2
  out=$( (run && if [ -n "${TEST_DATABASE_URL:-}" ]; then db; fi) 2>&1) && exit 0
  echo "bin/check failed — the code drifted from workflows.json, a promise has no command, lint failed, or (with TEST_DATABASE_URL set) a database check failed." >&2
  echo "Fix the cause before finishing (CLAUDE.md rule 11); do not raise a limit or loosen a rule." >&2
  # any case: pytest's "E   " and FAILED, ruff's would reformat, and the database's own words (psql's "ERROR:", a refused connection, rules.json)
  printf '%s\n' "$out" | grep -iE "error|fail|assert|would reformat|E   |refused|could not|rules" | head -20 >&2
  exit 2
fi
run
