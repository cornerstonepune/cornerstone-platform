#!/usr/bin/env python3
"""Which of CI's jobs a change needs. The standard library only; .github/workflows/ci.yml's `plan` job calls it
(goals/ci-fast-paths.yaml, docs/notes/ci-fast-paths.md):

  git diff --name-only --no-renames A...B | bin/ci-plan decide --event pull_request --draft false
      prints engine=, web=, browser=, seed=, full= (each true or false) and reason=, for $GITHUB_OUTPUT
      (--suite full: the nightly run's whole suite)
  bin/ci-plan seed-tests
      the engine's test files the data lane runs, one per line, as `tests/…` from packages/engine

Nimish, 2026-11-17: no pull request ever again runs about 3,900 tests. Every run of this workflow runs the CORE: the
engine's tests marked `core` (packages/engine/tests/core.txt) and the browser tests tagged `@core`, each on one runner,
under 10 minutes. The whole suite, plus bin/specs, runs once a night on main (.github/workflows/nightly.yml, which calls
ci.yml with suite=full); a red nightly is fixed first the next morning.

  the nightly run (suite=full)              everything: the twelve engine shards, the five browser shards, the proofs.
  main, a run by hand                       both cores, whatever changed.
  a pull request, draft or ready:
    files from DOCS_* alone                 the checks that need no database.
    seed data and notes alone (SEED_*)      the checks that need no database, and the tests that read the seed on one
                                            runner (SEED_TESTS), on a database of the schema and the seed.
    the website alone (apps/web, docs/frontend)
                                            the website's types, lint and build, and the browser core; no engine core.
    the engine alone (packages/engine)      the engine core; no browser core.
    anything else (the schema, bin/, .github/, the map, a rules.json, anything this cannot read)
                                            both cores.
"""

import argparse
import posixpath
import re
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent

# A change to any of these runs everything once the pull request is ready (and on main): the engine and its tests, the
# schema and the seed, the map of the code, the gates themselves.
SENSITIVE = ("packages/engine/", "supabase/migrations/", "supabase/seed/", "bin/", ".github/")
SENSITIVE_FILES = ("workflows.json",)
SENSITIVE_NAMES = ("rules.json",)  # wherever it sits

# Documents no test reads (test_ci_plan.py checks that against the tests themselves, bar READ_BY_TESTS). Not listed, so they run everything:
# BUILD-ORDER.md and DECISIONS-LOG.md, docs/design, docs/sources/*.md, docs/crosswalk, docs/spine, docs/ux-rules.md,
# docs/md-taxonomy.md and the rest of docs/*.md, which tests read.
DOCS_PREFIXES = (
    "docs/notes/",
    "docs/adr/",
    "docs/athena/",
    "docs/brainstorms/",
    "docs/drafts/",
    "docs/superpowers/",
    "docs/frontend/wireframes/",  # drawings; their checker (check.mjs) is run by bin/check, which every pull request runs
    "specs/UI-",  # a front-end slice's spec: read by people (the locked proofs are specs/CP-*, which tests do read)
)
DOCS_FILES = (
    "HANDOFF.md",
    "STATE.md",
    "README.md",
    "AGENTS.md",
    "ARCHITECTURE.md",
    "SPEC.md",
    "docs/sources/cornerstone-blueprint-v2.html",
)
# Inside the folders above, the files a test reads anyway. test_ci_plan.py fails on any other such file, and names it.
READ_BY_TESTS = (
    "docs/notes/nav3-what-needs-doing.md",  # apps/web/tests/u65-what-needs-doing-walk.spec.ts
    "docs/notes/m1-10-materials-list.md",  # tests/test_cli_materials.py
    "docs/notes/m1-01-voice-intake.md",  # tests/test_cli_voice.py
)
# Code that reads a listed folder but is run by bin/check, which every pull request runs: docs/adr, by `engine promises`
# (tests/test_promises.py); and the static design scan, which reads the frozen list of one-offs beside the tokens
# (tests/test_design_scale.py, CP-68). test_ci_plan.py checks bin/check still runs both tests.
READ_IN_BIN_CHECK = ("packages/engine/engine/checks/promises.py", "packages/engine/tests/test_design_scale.py")
WEB_PREFIX = "apps/web/"
# The screens' own documents (the list of screens and controls, the tokens, the spec built from them): only the browser tests read them (the
# inventory, the brand and token specs), no engine test does (test_ci_plan.py checks that), so a change to one is a change to the website.
# The wireframes in the folder stay documents (DOCS_PREFIXES): their checker runs in bin/check.
WEB_DOC_PREFIX = "docs/frontend/"

FULL = dict(engine=True, web=True, browser=True, seed=False, full=True)
CORE = dict(engine=True, web=True, browser=True, seed=False, full=False)
FAST = dict(engine=False, web=False, browser=False, seed=False, full=False)
ENGINE_PREFIX = "packages/engine/"

# The data lane: the seed's rows (curriculum, skills' sets and SKILL.md, config labels) and the two notes the tests read for
# decisions. A change to these alone cannot move code, so it runs the tests that read the seed or these notes, on one runner,
# and not the twelve shards or the browser. Files under docs/ that a test reads (docs/ux-rules.md …) are not on this list: they
# still run everything.
SEED_PREFIXES = ("supabase/seed/",)
SEED_FILES = ("DECISIONS-LOG.md", "CLAUDE.md")
# What that one runner runs: the loader and the seed's own checks, the map, the rules, the school's words, and the two tests
# that read DECISIONS-LOG.md. test_ci_plan.py proves each exists. Seed rows other tests read are found by the full run on main.
SEED_TESTS = (
    "tests/test_loaders.py",
    "tests/test_apply_seed.py",
    "tests/test_subject_map.py",
    "tests/test_skills.py",
    "tests/test_school_words.py",
    "tests/test_rules.py",
    "tests/test_layout.py",
    "tests/test_map_kind.py",
    "tests/test_story_shape_times.py",
    "tests/test_ci_plan.py",
)


def clean(path):
    """A repo-relative path as git prints it, or None when it is anything else: git quotes a name with odd bytes, and a path
    with `..` or `.` in it could name a place other than the one it starts with."""
    p = path.strip()
    if not p or p.startswith(('"', "/")) or "\\" in p:
        return None
    return p if posixpath.normpath(p) == p and not p.startswith("..") else None


def forces_full(path):
    return (
        path.startswith(SENSITIVE)
        or path in SENSITIVE_FILES
        or posixpath.basename(path) in SENSITIVE_NAMES
    )


def is_web(path):
    return path.startswith((WEB_PREFIX, WEB_DOC_PREFIX)) and not is_docs(path)


def is_seed(path):
    return path.startswith(SEED_PREFIXES) or path in SEED_FILES


def is_docs(path):
    return path not in READ_BY_TESTS and (path.startswith(DOCS_PREFIXES) or path in DOCS_FILES)


def is_engine(path):
    """The engine's code and tests alone: what the browser core cannot reach except through them (a migration can)."""
    return path.startswith(ENGINE_PREFIX) and posixpath.basename(path) not in SENSITIVE_NAMES


def decide(event, draft, files, suite="core"):
    """The jobs to start, as {engine, web, browser, seed, full, reason}. `files` are the change's paths, as git prints them.
    `draft` no longer changes anything: a draft and a ready pull request run the same core."""
    if suite == "full":
        return {**FULL, "reason": "the nightly run: the whole suite"}
    if event != "pull_request":
        return {**CORE, "reason": f"a {event} run: both cores"}
    paths = [clean(f) for f in files if f.strip()]
    if not paths or None in paths:
        return {**CORE, "reason": "changed files unknown or unreadable: both cores"}
    if all(is_docs(p) for p in paths):
        return {**FAST, "reason": "documents alone: the checks that need no database"}
    if all(is_docs(p) or is_seed(p) for p in paths):
        return {**FAST, "seed": True, "reason": "seed data and notes alone: the checks that need no database, and the seed's tests on one runner"}
    if all(is_docs(p) or is_web(p) for p in paths):
        return {**CORE, "engine": False, "reason": "the website alone: its types, lint and build, and the browser core"}
    if all(is_docs(p) or is_engine(p) for p in paths):
        return {**CORE, "web": False, "browser": False, "reason": "the engine alone: the engine core"}
    other = next((p for p in paths if not (is_docs(p) or is_web(p) or is_engine(p))), None)
    if other is None:
        return {**CORE, "reason": "the engine and the website together: both cores"}
    return {**CORE, "reason": f"{other} reaches both the engine and the website: both cores"}


def render(plan):
    keys = ("engine", "web", "browser", "seed", "full")
    return "".join(f"{k}={'true' if plan[k] else 'false'}\n" for k in keys) + f"reason={plan['reason']}\n"


# --- what the quick lists may hold --------------------------------------------------------------------------------------

SCANNED = (
    "packages/engine/tests",
    "packages/engine/engine",
    "apps/web/tests",
    "apps/web/app",
    "apps/web/lib",
    "apps/web/components",
)
READISH = re.compile(r"read_text|read_bytes|open\(|Path\(|\bROOT\b|REPO_ROOT|glob|readFile|\bjoin\(|/ *[\"']|[\"'] */")
SELF = ("test_ci_plan.py",)


def _forms(entry):
    """How code may spell a path: whole, or a folder's parts split ("docs" / "notes"), or a root file's bare name."""
    parts = entry.rstrip("/").split("/")
    if len(parts) == 1:
        return [re.escape(parts[0])]
    return [re.escape("/".join(parts)), r"[\"'][ ,/]*[\"']".join(re.escape(x) for x in parts)]


def reads_of(entries, folders=SCANNED):
    """Lines in the engine's code and tests, or the browser tests, that read a file on a quick list. Comments and docstrings that
    only mention one are not reads, so a line counts when it also builds a path or opens a file."""
    hits = []
    for folder in folders:
        for path in (REPO / folder).rglob("*"):
            if path.suffix not in {".py", ".ts", ".tsx"} or path.name in SELF or "node_modules" in path.parts:
                continue
            if path.relative_to(REPO).as_posix() in READ_IN_BIN_CHECK:
                continue
            for n, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
                if line.lstrip().startswith(("#", "//", "*")) or not READISH.search(line):
                    continue
                if any(posixpath.basename(f) in line for f in READ_BY_TESTS):
                    continue
                for entry in entries:
                    if any(re.search(f, line) for f in _forms(entry)):
                        hits.append(f"{path.relative_to(REPO)}:{n} reads {entry}")
    return hits


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    d = sub.add_parser("decide")
    d.add_argument("--event", required=True)
    d.add_argument("--draft", required=True, choices=["true", "false"])
    d.add_argument("--suite", default="core", choices=["core", "full"])
    sub.add_parser("seed-tests")
    args = ap.parse_args(argv)
    if args.cmd == "seed-tests":
        print("\n".join(SEED_TESTS))
        return 0
    sys.stdout.write(render(decide(args.event, args.draft == "true", sys.stdin.read().splitlines(), args.suite)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
