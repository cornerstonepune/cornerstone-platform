#!/usr/bin/env bash
# Prove, on the live database's own connection pooler, that one person's identity never reaches the next request (CP-2).
# From anywhere:
#   ~/cornerstone/assessment-engine/bin/check-pooler
# Read-only: it sets a transaction-local value and reads it back, and touches no table. DATABASE_URL comes from .env
# (never printed); the pooler's port is used. Needs Node 22.18 or newer (it runs a .ts file directly; confirmed on 22.23)
# and the website's packages installed (apps/web/node_modules). It prints what it found and exits non-zero on any leak.
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
LIVE=$(grep -E '^DATABASE_URL=' "$REPO/.env" | cut -d= -f2- | tr -d "\"'") || true
[ -n "${LIVE:-}" ] || { echo "DATABASE_URL is not in $REPO/.env, so there is no database to check." >&2; exit 1; }

command -v node >/dev/null || { echo "Node is not installed. This check needs Node 22.18 or newer." >&2; exit 1; }
node -e 'const [a,b]=process.versions.node.split(".").map(Number); process.exit(a>22||(a===22&&b>=18)?0:1)' ||
  { echo "Node $(node --version) is too old. This check needs Node 22.18 or newer." >&2; exit 1; }
[ -d "$REPO/apps/web/node_modules/postgres" ] ||
  { echo "The website's packages are not installed. Run: npm ci --prefix $REPO/apps/web" >&2; exit 1; }

cd "$REPO/apps/web"
CHECK_POOLER_URL="$LIVE" exec node scripts/check-pooler.ts
